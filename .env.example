ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=True

# Shared Alpaca news store (VADER + AGY read the same snapshot)
# NEWS_DB_PATH=data/news/news.sqlite3
# NEWS_RAW_DIR=data/news/raw
# NEWS_CACHE_TTL_SECONDS=600
# NEWS_LOOKBACK_HOURS=72
# NEWS_BATCH_SIZE=20
# NEWS_MAX_PAGES_PER_BATCH=20
# NEWS_YFINANCE_FALLBACK=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=True

# Runtime news analysis (default): AGY OAuth/subscription quota
LLM_PROVIDER=agy
# AGY_LLM_MODEL=claude-opus-4-6-thinking
# AGY_LLM_FALLBACK_MODEL=gemini-3.1-pro-high
# AGY_CLI_PATH=agy
# AGY_PRINT_TIMEOUT_SECONDS=90
# AGY_PROCESS_TIMEOUT_SECONDS=105

# Optional legacy Google AI Studio provider (LLM_PROVIDER=auto or gemini)
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Dry-run: live LLM on cache miss by default (paper --execute always live)
# LLM_CACHE_ONLY_DRY_RUN=1   # dry-run uses cache only, no LLM call
# LLM_LIVE_IN_DRY_RUN=0      # legacy alias for cache-only dry-run
# TRADING_BOT_SKIP_LLM=1     # pytest/CI — tests/conftest.py sets this

# Local vLLM fallback after both AGY model quotas/errors — default OFF
# LLM_VLLM_ENABLED=1
# LLM_VLLM_BASE_URL=http://192.168.219.116:11434/v1
# LLM_VLLM_MODEL=gemma4-26B
# LLM_VLLM_TIMEOUT=120
# LLM_VLLM_MAX_TOKENS=512

# Toss Securities Open API (https://openapi.tossinvest.com)
# OAuth2 client_credentials keys from Toss WTS → 설정 → Open API
TOSS_CLIENT_ID=
TOSS_SECRET_KEY=
# X-Tossinvest-Account seq (blank = auto-resolve first account)
TOSS_ACCOUNT=
# TOSS_API_BASE=https://openapi.tossinvest.com
# TOSS_TIMEOUT=15
