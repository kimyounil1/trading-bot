    *,
    settings,
    ticker_data: dict[str, pd.DataFrame],
    vix_df: pd.DataFrame | None,
    macro_df: pd.DataFrame | None,
    model_wrapper,
    eval_start: pd.Timestamp,
    eval_end: pd.Timestamp,
) -> dict:
    """Portfolio backtest on holdout-only price data for model promotion."""
