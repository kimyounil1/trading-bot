 _STRATEGY_SETTINGS_FIELD_NAMES = {item.name for item in fields(StrategySettings)}
 _PROFILE_OVERRIDE_FIELD_NAMES = _STRATEGY_SETTINGS_FIELD_NAMES - {"name", "tickers"}
