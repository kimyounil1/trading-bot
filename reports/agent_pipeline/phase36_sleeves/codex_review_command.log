     return f"intent_{uuid.uuid4().hex[:12]}"
 
 
 def build_buy_intent(
     *,
     run_id: str,
     ticker: str,
     notional: float,
     signal: str = "",
     ai_score: Optional[float] = None,
     rank_ai_score: Optional[float] = None,
     rank_ai_percentile: Optional[float] = None,
     llm_verdict: str = "",
