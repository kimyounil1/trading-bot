     alignment = (live or {}).get("alignment") or {}
     for note in alignment.get("notes") or []:
         st.info(note)
 
     if gate is None and live is None:
         st.caption(
             "산출물 없음 — 아래 **Crowding live 리포트 생성** 또는 "
             "`bash scripts/run_crowding_live_impact_report.sh`"
