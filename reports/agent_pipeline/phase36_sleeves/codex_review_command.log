 def get_recent_order_ids(limit: int = 10) -> list[str]:
     orders_df = read_csv_if_exists(ORDER_LOG_PATH)
 
     if orders_df.empty or "order_id" not in orders_df.columns:
         return []
 
     order_ids = (
         orders_df["order_id"]
         .dropna()
         .astype(str)
         .loc[lambda series: series.str.len() > 0]
         .drop_duplicates()
         .tail(limit)
         .tolist()
     )
 
     return order_ids
 
 
