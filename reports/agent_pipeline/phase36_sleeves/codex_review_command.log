     gate_decision = str((gate or {}).get("decision") or "—")
     live_block = (live or {}).get("live") or {}
     if not live_block and paper_ops:
         live_block = (paper_ops.get("crowding_live") or {})
 
     c1, c2, c3, c4 = st.columns(4)
