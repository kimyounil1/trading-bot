         return pd.to_numeric(trades_df["exit_value"], errors="coerce") - pd.to_numeric(
             trades_df["cost_basis"], errors="coerce"
         )
     return pd.to_numeric(trades_df["return_pct"], errors="coerce") * pd.to_numeric(
         trades_df["cost_basis"], errors="coerce"
