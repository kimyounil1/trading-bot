+            "crowding_skip_rate_of_skips": crowding_live.get("live", {}).get(
+                "crowding_skip_rate_of_skips", 0.0
+            ),
+            "by_kind": crowding_live.get("live", {}).get("by_kind", {}),
+            "top_tickers": dict(
+                list(
+                    sorted(
