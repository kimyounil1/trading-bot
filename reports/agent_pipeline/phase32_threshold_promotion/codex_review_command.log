        )
    except Exception as exc:
        if bool(getattr(settings, "rank_ai_buy_gate_fail_closed", True)):
            raise
        print(f"Warning: rank AI buy/add gate disabled for candidate cache: {exc}")
        rank_ai_gate_scores = {}

    ai_model_bundle = None
