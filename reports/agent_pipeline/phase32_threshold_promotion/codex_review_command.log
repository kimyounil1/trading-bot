    last_equity = account.get("last_equity", account["portfolio_value"])
    
    # Drawdown Circuit Breaker: 전일 대비 -15% 이상 하락 시 신규 매수 중단
    # (주의: 레버리지 사용 시 실질 낙폭이 더 클 수 있으므로 실제 portfolio_value 기준 체크)
