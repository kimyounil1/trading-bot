+    "rate_limit",
+    "ratelimit",
+    "too many requests",
+    "429",
+    "503",
+    "unavailable",
+    "quota",
+)
+_NON_RETRYABLE_AUTH_MARKERS = (
+    "invalid api key",
+    "api key not valid",
+    "permission denied",
+    "unauthenticated",
