class AllocationType(Enum):
    EQUAL_WEIGHT = "equal_weight"
    FIXED_WEIGHT = "fixed_weight"
    RISK_PARITY = "risk_parity"


@dataclass
class StrategyProfile:
    """개별 전략의 기술적 지표 및 필터 설정"""

    name: str
    tickers: List[str]

    # 기술적 지표 (MA, RSI 등)
