+    config_path: Path = DEFAULT_STRATEGY_CONFIG_PATH,
+    proposal_path: Path = PROPOSAL_PATH,
+    dry_run: bool = False,
 ) -> dict[str, Any]:
     guard_report = load_guard_impact_summary(guard_impact_path)
