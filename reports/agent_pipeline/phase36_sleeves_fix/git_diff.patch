+     {
+       "portfolio_sleeves_enabled": true,
+       "sleeves": {
+         "core": {
+           "enabled": true,
+           "target_weight": 0.50,
+           "profile": "paper",
+           "strategy": "current_core"
+         },
+         "tournament": {
