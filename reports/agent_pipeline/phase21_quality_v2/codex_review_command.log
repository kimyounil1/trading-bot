            print(f"  WARNING: insufficient data for {regime} regime (rows={len(regime_data)}), skipping...")
            continue
            
        print(f"  Training {regime} ensemble model (LightGBM + XGBoost, rows={len(regime_data)})...")
        X_regime = regime_data[FEATURE_COLUMNS]
