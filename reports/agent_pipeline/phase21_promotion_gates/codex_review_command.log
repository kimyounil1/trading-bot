            "bin_count": 0,
        }, pd.DataFrame()

    regime_brier: dict[str, Any] = {}
    if "brier_score" in metrics_df.columns and "regime" in metrics_df.columns:
        for regime, regime_df in metrics_df.groupby("regime"):

